#!/bin/sh
# =============================================================================
# rc.hunter - pfSense Threat Hunter  |  VERSION: 37
# Main menu launcher — sources lib_shared.sh and calls individual modules.
#
# Usage:
#   sh rc.hunter          (run from Scripts/ directory)
#   sh Scripts/rc.hunter  (run from repo root)
# =============================================================================
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
export SCRIPT_DIR
. "$SCRIPT_DIR/lib_shared.sh"

# Patterns used by sweep and process modules
_PROC_PAT='(nc -[el]|ncat|bash -i|bash -c /|/dev/tcp|/dev/udp|python.*-c|perl.*-e|mkfifo|socat.*exec|xmrig|minerd|ccminer|cgminer)'
_MINER_PAT='xmrig|minerd|cgminer|bfgminer|cpuminer|ethminer|t-rex|nbminer|lolminer'

view_logs() {
    draw_screen
    printf "\n  ${B}View Logs${N}\n"
    divider
    printf "\n  Log directory: %s\n\n" "$LOG_DIR"
    _files="$(ls -t "$LOG_DIR" 2>/dev/null)"
    if [ -z "$_files" ]; then
        msg_in "No log files found yet."
        press_enter; return
    fi
    _i=1
    for _f in $_files; do
        printf "  %s) %s\n" "$_i" "$_f"
        _i=$((_i+1))
    done
    printf "\n  Select file number to view (0 to cancel): "
    read _num; [ "$_num" = "0" ] && return
    _fname="$(echo "$_files" | sed -n "${_num}p")"
    [ -z "$_fname" ] && return
    less "$LOG_DIR/$_fname" 2>/dev/null || while IFS= read -r _l; do
        printf "%s\n" "$_l"
    done < "$LOG_DIR/$_fname" 2>/dev/null
    press_enter
}

while true; do
    draw_menu
    read _choice
    case "$_choice" in
        1) sh "$SCRIPT_DIR/user_deletion.sh" ;;
        2) sh "$SCRIPT_DIR/restore_binaries.sh" ;;
        3) sh "$SCRIPT_DIR/hunt_shells.sh" ;;
        4) sh "$SCRIPT_DIR/manage_ssh.sh" ;;
        5) sh "$SCRIPT_DIR/analyze_procs.sh" ;;
        6) view_logs ;;
        7) sh "$SCRIPT_DIR/full_sweep.sh" ;;
        8) sh "$SCRIPT_DIR/restore_config.sh" ;;
        0) clear; printf "  Returning to shell.\n\n"; exit 0 ;;
        *) sleep 1 ;;
    esac
done
